{
  "name": "zonneplan-mcp",
  "version": "1.0.0",
  "description": "Onoffici\u00eble read-only MCP-server voor Zonneplan (Claude Desktop extensie)",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node18 --format=cjs --outfile=bundle/server/index.cjs --legal-comments=none",
    "test": "npm run build && node test/mock-test.cjs",
    "pack": "npm run build && mcpb validate bundle/manifest.json && mcpb pack bundle zonneplan.mcpb"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "esbuild": "^0.28.2"
  },
  "private": true
}
